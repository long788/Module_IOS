<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Spotify VIP &amp; YouTube Premium DNS</string>
    <key>PayloadDescription</key>
    <string>Cấu hình DNS thuần mở khóa Spotify Eevee VIP và YouTube Premium (chặn quảng cáo, phát nhạc trong nền, PiP). Không cài chứng chỉ CA, không đụng tới Locket.</string>
    <key>PayloadOrganization</key>
    <string>Spotify &amp; YouTube VIP</string>
    <key>PayloadIdentifier</key>
    <string>com.spotify.youtube.vip.profile</string>
    <key>PayloadUUID</key>
    <string>9DDC879A-ABB8-4BDB-9984-C53A273581E8</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadContent</key>
    <array>
        <!-- Cấu hình DNS duy nhất (Không cần chứng chỉ Root CA, không cần cấp quyền tin cậy) -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.spotify.youtube.vip.dns</string>
            <key>PayloadUUID</key>
            <string>C3D4E5F6-7890-1234-5678-90ABCDEF1234</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Spotify &amp; YouTube VIP DNS</string>
            <key>PayloadOrganization</key>
            <string>Spotify &amp; YouTube VIP</string>
            <key>PayloadDescription</key>
            <string>Cấu hình DNS mở khóa Spotify Eevee VIP và YouTube Premium.</string>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://103.101.161.228/dns-query</string>
                <key>ServerAddresses</key>
                <array>
                    <string>103.101.161.228</string>
                </array>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- [Spotify Rules - iPad Mode & Eevee VIP] -->
                    <string>spclient.wg.spotify.com</string>
                    <string>wg.spotify.com</string>
                    <string>apresolve.spotify.com</string>
                    <string>gae2-spclient.spotify.com</string>
                    <string>guc3-spclient.spotify.com</string>
                    <string>gue1-spclient.spotify.com</string>
                    <string>gew1-spclient.spotify.com</string>
                    <string>guc3.spotify.com</string>
                    <string>gue3.spotify.com</string>
                    <string>gua3.spotify.com</string>

                    <!-- [YouTube Premium - Chặn quảng cáo, chạy nền, PiP] -->
                    <string>youtubei.googleapis.com</string>
                    <string>s.youtube.com</string>
                    <string>www.youtube.com</string>
                    <string>youtube.com</string>
                    <string>googlevideo.com</string>
                </array>
            </dict>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>EvaluateConnection</string>
                    <key>ActionParameters</key>
                    <array>
                        <dict>
                            <key>DomainAction</key>
                            <string>NeverConnect</string>
                            <key>Domains</key>
                            <array>
                                <!-- Chặn quảng cáo YouTube & Tracking Sentry -->
                                <string>sentry.io</string>
                                <string>ingest.sentry.io</string>
                                <string>googleads.g.doubleclick.net</string>
                                <string>pagead2.googlesyndication.com</string>
                                <string>static.doubleclick.net</string>
                                <string>ad.youtube.com</string>
                                <string>ads.youtube.com</string>
                                <string>s0.2mdn.net</string>
                                <string>pubads.g.doubleclick.net</string>
                                <string>securepubads.g.doubleclick.net</string>
                            </array>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
            </array>
        </dict>
    </array>
</dict>
</plist>
