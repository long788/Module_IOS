    <key>PayloadDisplayName</key>
    <string>Spotify VIP &amp; YouTube Premium</string>
    <key>PayloadDescription</key>
    <string>Cấu hình mở khóa Spotify Eevee VIP (bỏ ép trộn bài, nghe nhạc chọn bài tự do, gỡ quảng cáo) &amp; YouTube Premium (chặn quảng cáo, phát nhạc trong nền, PiP). Độc lập 100%, đã loại bỏ hoàn toàn phần Locket cũ.</string>
    <key>PayloadOrganization</key>
    <string>Spotify &amp; YouTube VIP</string>
    <key>PayloadIdentifier</key>
    <string>com.spotify.youtube.vip.profile</string>
    <key>PayloadUUID</key>
    <string>9DDC879A-ABB8-4BDB-9984-C53A273581E8</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadContent</key>
