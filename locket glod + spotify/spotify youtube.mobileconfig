<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Spotify VIP &amp; YouTube Premium</string>
    <key>PayloadDescription</key>
    <string>Cấu hình mở khóa Spotify Eevee VIP (bỏ ép trộn bài, nghe nhạc chọn bài tự do, gỡ quảng cáo) &amp; YouTube Premium (chặn quảng cáo, phát nhạc trong nền, PiP).</string>
    <key>PayloadOrganization</key>
    <string>Spotify &amp; YouTube VIP</string>
    <key>PayloadIdentifier</key>
    <string>com.spotify.youtube.vip.profile</string>
    <key>PayloadUUID</key>
    <string>9ddc879a-abb8-4bdb-9984-c53a273581e8</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadContent</key>
    <array>
        <!-- ① Chứng chỉ gốc Root CA (Hỗ trợ giải mã HTTPS cho Spotify VIP & YouTube Premium) -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.security.root</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.spotifyyoutube.rootca</string>
            <key>PayloadUUID</key>
            <string>bb0640e5-040b-4ecc-9f5c-53157883582a</string>
            <key>PayloadDisplayName</key>
            <string>Spotify &amp; YouTube Root CA</string>
            <key>PayloadDescription</key>
            <string>Chứng chỉ gốc hỗ trợ mở khóa Spotify VIP &amp; YouTube Premium</string>
            <key>PayloadContent</key>
            <data>

            </data>
        </dict>

        <!-- ② Cấu hình DNS (Chỉ định tuyến riêng Spotify & YouTube Premium, đã bỏ hoàn toàn Locket) -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.spotifyyoutube.vip</string>
            <key>PayloadUUID</key>
            <string>C3D4E5F6-7890-1234-5678-90ABCDEF1234</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Spotify &amp; YouTube VIP DNS</string>
            <key>PayloadOrganization</key>
            <string>Spotify &amp; YouTube VIP</string>
            <key>PayloadDescription</key>
            <string>Cấu hình DNS mở khóa Spotify Eevee VIP và YouTube Premium (chạy nền, PiP, chặn quảng cáo).</string>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://160-191-242-70.sslip.io/dns-query/2ec0e3cf7abc</string>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- [Spotify Rules - iPad Mode & Eevee VIP (bootstrap / customize / artistview / album)] -->
                    <string>spclient.wg.spotify.com</string>
                    <string>wg.spotify.com</string>
                    <string>apresolve.spotify.com</string>
                    <string>gae2-spclient.spotify.com</string>
                    <string>guc3-spclient.spotify.com</string>
                    <string>gue1-spclient.spotify.com</string>
                    <string>gew1-spclient.spotify.com</string>
                    <string>guc3.spotify.com</string>
                    <string>gue3.spotify.com</string>
                    <string>gua3.spotify.com</string>

                    <!-- [YouTube Premium - API browse / next / player / search / reel / get_watch] -->
                    <string>youtubei.googleapis.com</string>
                </array>
            </dict>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>EvaluateConnection</string>
                    <key>ActionParameters</key>
                    <array>
                        <dict>
                            <key>DomainAction</key>
                            <string>NeverConnect</string>
                            <key>Domains</key>
                            <array>
                                <!-- Chặn quảng cáo YouTube & Tracking Sentry theo đúng sgmodule -->
                                <string>googleads.g.doubleclick.net</string>
                                <string>pagead2.googlesyndication.com</string>
                                <string>static.doubleclick.net</string>
                                <string>ad.youtube.com</string>
                                <string>ads.youtube.com</string>
                                <string>s0.2mdn.net</string>
                                <string>pubads.g.doubleclick.net</string>
                                <string>securepubads.g.doubleclick.net</string>
                                <string>sentry.io</string>
                                <string>ingest.sentry.io</string>
                            </array>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
            </array>
        </dict>
    </array>
</dict>
</plist>
