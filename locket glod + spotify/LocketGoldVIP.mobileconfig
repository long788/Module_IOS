                                <string>locketlabs-locketcamera.adsbynimbus.com</string>
                                <string>api2.amplitude.com</string>
                                <string>appsflyersdk.com</string>
                            </array>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
