<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Locket Gold Vip 💛</string>
    <key>PayloadDescription</key>
    <string>Hồ sơ VIP đóng băng bản quyền Locket Gold vĩnh viễn và chống thu hồi chứng chỉ Apple (Anti-Revoke). @locket_gold_vip</string>
