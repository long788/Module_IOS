            <string>Locket Gold Vip DNS</string>
            <key>PayloadOrganization</key>
            <string>Locket Gold Vip 💛</string>
            <key>PayloadDescription</key>
            <string>Cấu hình DNS đóng băng Locket Gold VIP và chống thu hồi chứng chỉ Apple.</string>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://cloudflare-dns.com/dns-query</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.1</string>
                    <string>1.0.0.1</string>
                    <string>2606:4700:4700::1111</string>
                    <string>2606:4700:4700::1001</string>
                </array>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- Apple Anti-Revoke -->
                    <string>certs.apple.com</string>
