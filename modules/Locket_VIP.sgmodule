#!url=https://raw.githubusercontent.com/long788/Module_IOS/refs/heads/main/modules/Locket_VIP.sgmodule
#!name=Locket-VIP_Gold
#!desc=King of Locket Edition

[Header Rewrite]
http-request ^https?://api\.revenuecat\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
http-request ^https?://api\.revenuecat\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
http-request ^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
http-request ^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match

[Script]
# ~ King of Locket
# ～ Egern transfer to Shadowrocket & Surge & LanceX
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/long788/Module_IOS/refs/heads/main/js/Locket_VIP.js, requires-body=true, max-size=-1, timeout=60, script-update-interval=0
deleteHeader = type=http-request, pattern=^https:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+), script-path=https://raw.githubusercontent.com/long788/Module_IOS/refs/heads/main/js/deleteHeader.js, timeout=60, script-update-interval=0
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/long788/Module_IOS/refs/heads/main/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60, script-update-interval=0

[MITM]
h2 = true
enable = true
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
